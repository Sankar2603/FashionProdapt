# Copy to .env and fill in the CHANGE_ME values:
#   Copy-Item .env.example .env
# Host scripts read these as-is; docker-compose.yml overrides the URLs that
# must point at other containers (redis, qdrant, postgres, ...).

# ---------- Postgres ----------
POSTGRES_USER=fashion
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=fashion_catalog
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://fashion:CHANGE_ME@127.0.0.1:5432/fashion_catalog

# ---------- Redis / Qdrant ----------
# db 0: intent cache, search-result cache, catalogue version, rate limits
REDIS_URL=redis://127.0.0.1:6379/0
QDRANT_URL=http://127.0.0.1:6333
# Leave empty locally; set it (and enable it in docker-compose.yml) when deploying.
QDRANT_API_KEY=
QDRANT_COLLECTION=fashion_items_v1
QDRANT_ALIAS=fashion_items_active

# ---------- Ingestion ----------
# Folder holding Amazon_Fashion.jsonl and meta_Amazon_Fashion.jsonl
RAW_DATA_DIR=.
SAMPLE_MAX_ITEMS=5000
# Bayesian rating: how many ratings it takes before a product's own average is trusted
BAYES_M=20

# ---------- Embeddings ----------
EMBEDDING_MODEL=BAAI/bge-m3
# cuda or cpu (host scripts only; the containers always use cpu)
EMBEDDING_DEVICE=cuda
EMBEDDING_MAX_LENGTH=512
EMBEDDING_BATCH_SIZE=16
# Host folder with an already-downloaded Hugging Face cache, mounted into the
# containers. Empty = a Docker volume; the models download into it once.
HF_CACHE_DIR=
# 1 = never download (only when HF_CACHE_DIR already holds the models)
HF_HUB_OFFLINE=0

# ---------- LLM (Query Service) ----------
# groq or ollama
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
# Reasoning models on Groq (gpt-oss): low | medium | high
LLM_REASONING_EFFORT=low
GROQ_API_KEY=CHANGE_ME
LLM_TIMEOUT_S=8
# Retries inside the LLM_TIMEOUT_S budget (absorbs a brief 429)
LLM_MAX_RETRIES=1
INTENT_CACHE_TTL_S=86400
# Only used when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ---------- Reranker ----------
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_MAX_LENGTH=256
RERANKER_BATCH_SIZE=16

# ---------- Gateway ----------
RATE_LIMIT_PER_MINUTE=30
QUERY_TIMEOUT_S=10
RETRIEVAL_TIMEOUT_S=10
RERANK_TIMEOUT_S=30
RETRIEVE_TOP_K=20
# Search-result cache lifetime in seconds (0 disables it)
SEARCH_CACHE_TTL_S=600

# ---------- Catalog Service ----------
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=CHANGE_ME
WEBHOOK_TOLERANCE_S=300
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CATALOG_URL=http://127.0.0.1:8002

# ---------- Worker ----------
RECONCILE_INTERVAL_S=300
RECONCILE_WINDOW_MIN=30
FULL_RECONCILE_INTERVAL_S=21600
SYNC_MAX_RETRIES=8

# ---------- Logging ----------
LOG_LEVEL=INFO
